# Secrets stay server-side and this file is safe to commit as a template.
PORTKEY_API_KEY=
PORTKEY_GATEWAY_URL=https://aigw.portkey.ai/v1

# Provider profile and the three role routes.
PORTKEY_PROVIDER_SLUG=gemini-example
PORTKEY_ROLE_COUNT=3

PORTKEY_ROLE_1_ID=sales
PORTKEY_ROLE_1_LABEL=Sales
PORTKEY_ROLE_1_MODEL=gemini-3.5-flash-lite

PORTKEY_ROLE_2_ID=hr
PORTKEY_ROLE_2_LABEL=HR
PORTKEY_ROLE_2_MODEL=gemini-3.6-flash

PORTKEY_ROLE_3_ID=devs
PORTKEY_ROLE_3_LABEL=Devs
PORTKEY_ROLE_3_MODEL=gemini-3.5-flash
