#!/usr/bin/env bash
set -euo pipefail

env_file=${PORTKEY_ONBOARD_ENV_FILE:-/root/portkey-model-console/.env}
routing_file=${PORTKEY_ONBOARD_ROUTING_FILE:-/root/portkey-role-routing-config.json}
service_name=${PORTKEY_ONBOARD_SERVICE_NAME:-portkey-model-console}
service_group=${PORTKEY_ONBOARD_SERVICE_GROUP:-www-data}
restart_service=1

if [[ ${1:-} == "--no-restart" ]]; then
  restart_service=0
  shift
fi

if [[ $# -ne 0 ]]; then
  echo "Usage: $0 [--no-restart]" >&2
  exit 2
fi

if [[ ${EUID} -ne 0 ]]; then
  echo "Run this helper as root." >&2
  exit 1
fi

current_value() {
  local key=$1
  local fallback=$2
  local value=

  if [[ -f ${env_file} ]]; then
    value=$(sed -n "s/^${key}=//p" "${env_file}" | tail -n 1)
    value=${value#\"}
    value=${value%\"}
  fi

  printf '%s' "${value:-${fallback}}"
}

trim_value() {
  local value=$1
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  printf '%s' "${value}"
}

escape_env_value() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

prompt_value() {
  local destination=$1
  local prompt=$2
  local default_value=$3
  local entered_value=

  IFS= read -r -p "${prompt} [${default_value}]: " entered_value || true
  entered_value=$(trim_value "${entered_value}")
  printf -v "${destination}" '%s' "${entered_value:-${default_value}}"
}

role_id_from_label() {
  local label=$1
  printf '%s' "${label}" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

normalize_model() {
  local model=$1
  if [[ ${model} == @*/* ]]; then
    model=${model#*/}
  fi
  printf '%s' "${model}"
}

old_key=$(current_value PORTKEY_API_KEY "")
gateway_url=$(current_value PORTKEY_GATEWAY_URL "https://aigw.portkey.ai/v1")
default_slug=$(current_value PORTKEY_PROVIDER_SLUG "gemini-example")
default_slug=${default_slug#@}

default_role_1=$(current_value PORTKEY_ROLE_1_LABEL "Sales")
default_role_2=$(current_value PORTKEY_ROLE_2_LABEL "HR")
default_role_3=$(current_value PORTKEY_ROLE_3_LABEL "Devs")
default_model_1=$(current_value PORTKEY_ROLE_1_MODEL "gemini-3.5-flash-lite")
default_model_2=$(current_value PORTKEY_ROLE_2_MODEL "gemini-3.6-flash")
default_model_3=$(current_value PORTKEY_ROLE_3_MODEL "gemini-3.5-flash")

default_model_1=$(normalize_model "${default_model_1}")
default_model_2=$(normalize_model "${default_model_2}")
default_model_3=$(normalize_model "${default_model_3}")

echo "AI Role Demo onboarding"
echo "Press Enter to keep each value shown in brackets."
echo

if [[ -n ${old_key} ]]; then
  IFS= read -r -s -p "Portkey service API key (Enter keeps current): " new_key || true
  echo
  portkey_key=${new_key:-${old_key}}
else
  IFS= read -r -s -p "Portkey service API key: " portkey_key || true
  echo
fi

if [[ -z ${portkey_key} ]]; then
  echo "A Portkey service API key is required." >&2
  exit 1
fi

prompt_value provider_slug "LLM profile slug" "${default_slug}"
provider_slug=${provider_slug#@}

if [[ ! ${provider_slug} =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo "The LLM profile slug may contain only letters, numbers, underscores, and hyphens." >&2
  exit 1
fi

prompt_value role_1_label "Role 1 name" "${default_role_1}"
prompt_value role_1_model "Google model for ${role_1_label}" "${default_model_1}"
prompt_value role_2_label "Role 2 name" "${default_role_2}"
prompt_value role_2_model "Google model for ${role_2_label}" "${default_model_2}"
prompt_value role_3_label "Role 3 name" "${default_role_3}"
prompt_value role_3_model "Google model for ${role_3_label}" "${default_model_3}"

role_1_model=$(normalize_model "${role_1_model}")
role_2_model=$(normalize_model "${role_2_model}")
role_3_model=$(normalize_model "${role_3_model}")

role_1_id=$(role_id_from_label "${role_1_label}")
role_2_id=$(role_id_from_label "${role_2_label}")
role_3_id=$(role_id_from_label "${role_3_label}")

if [[ -z ${role_1_id} || -z ${role_2_id} || -z ${role_3_id} ]]; then
  echo "Each role name must contain at least one ASCII letter or number." >&2
  exit 1
fi

if [[ ${role_1_id} == "${role_2_id}" ||
      ${role_1_id} == "${role_3_id}" ||
      ${role_2_id} == "${role_3_id}" ]]; then
  echo "Role names must produce three unique role IDs." >&2
  exit 1
fi

for model in "${role_1_model}" "${role_2_model}" "${role_3_model}"; do
  if [[ -z ${model} || ! ${model} =~ ^[A-Za-z0-9._:/-]+$ ]]; then
    echo "Google model IDs may contain only letters, numbers, dots, underscores, colons, slashes, and hyphens." >&2
    exit 1
  fi
done

umask 077
temp_env=$(mktemp)
temp_json=$(mktemp)
trap 'rm -f "${temp_env}" "${temp_json}"' EXIT

{
  printf 'PORTKEY_API_KEY="%s"\n' "$(escape_env_value "${portkey_key}")"
  printf 'PORTKEY_GATEWAY_URL="%s"\n' "$(escape_env_value "${gateway_url}")"
  printf 'PORTKEY_PROVIDER_SLUG="%s"\n' "$(escape_env_value "${provider_slug}")"
  printf 'PORTKEY_ROLE_COUNT="3"\n'
  printf 'PORTKEY_ROLE_1_ID="%s"\n' "$(escape_env_value "${role_1_id}")"
  printf 'PORTKEY_ROLE_1_LABEL="%s"\n' "$(escape_env_value "${role_1_label}")"
  printf 'PORTKEY_ROLE_1_MODEL="%s"\n' "$(escape_env_value "${role_1_model}")"
  printf 'PORTKEY_ROLE_2_ID="%s"\n' "$(escape_env_value "${role_2_id}")"
  printf 'PORTKEY_ROLE_2_LABEL="%s"\n' "$(escape_env_value "${role_2_label}")"
  printf 'PORTKEY_ROLE_2_MODEL="%s"\n' "$(escape_env_value "${role_2_model}")"
  printf 'PORTKEY_ROLE_3_ID="%s"\n' "$(escape_env_value "${role_3_id}")"
  printf 'PORTKEY_ROLE_3_LABEL="%s"\n' "$(escape_env_value "${role_3_label}")"
  printf 'PORTKEY_ROLE_3_MODEL="%s"\n' "$(escape_env_value "${role_3_model}")"
} >"${temp_env}"

python3 - \
  "${provider_slug}" \
  "${role_1_id}" "${role_1_model}" \
  "${role_2_id}" "${role_2_model}" \
  "${role_3_id}" "${role_3_model}" >"${temp_json}" <<'PY'
import json
import sys

provider_slug = sys.argv[1]
roles = [
    (sys.argv[2], sys.argv[3]),
    (sys.argv[4], sys.argv[5]),
    (sys.argv[6], sys.argv[7]),
]

conditions = []
targets = []
for index, (role_id, model) in enumerate(roles, start=1):
    target_name = f"role-{index}-route"
    conditions.append(
        {
            "query": {"metadata.user_role": {"$eq": role_id}},
            "then": target_name,
        }
    )
    targets.append(
        {
            "name": target_name,
            "override_params": {
                "model": f"@{provider_slug}/{model}",
            },
        }
    )

config = {
    "strategy": {
        "mode": "conditional",
        "conditions": conditions,
        "default": "role-1-route",
    },
    "targets": targets,
}
json.dump(config, sys.stdout, indent=2)
sys.stdout.write("\n")
PY

python3 -m json.tool "${temp_json}" >/dev/null
install -o root -g "${service_group}" -m 660 "${temp_env}" "${env_file}"
install -o root -g "${service_group}" -m 660 "${temp_json}" "${routing_file}"

if [[ ${restart_service} -eq 1 ]]; then
  systemctl restart "${service_name}"
  systemctl is-active --quiet "${service_name}"
fi

echo
echo "Onboarding complete."
echo "Environment: ${env_file}"
echo "Routing JSON: ${routing_file}"
echo
printf '  %s -> @%s/%s\n' "${role_1_label}" "${provider_slug}" "${role_1_model}"
printf '  %s -> @%s/%s\n' "${role_2_label}" "${provider_slug}" "${role_2_model}"
printf '  %s -> @%s/%s\n' "${role_3_label}" "${provider_slug}" "${role_3_model}"
echo
echo "Paste the generated JSON into the saved routing configuration and save it."
