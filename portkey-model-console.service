[Unit]
Description=Portkey role-aware SPA and secure gateway proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/root/portkey-model-console
EnvironmentFile=-/root/portkey-model-console/.env
Environment=HOST=0.0.0.0
Environment=PORT=80
Environment=PORTKEY_ROUTING_CONFIG_FILE=/root/portkey-role-routing-config.json
ExecStart=/usr/bin/python3 /root/portkey-model-console/server.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=true
RemoveIPC=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=tmpfs
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
BindPaths=/root/portkey-model-console /root/portkey-role-routing-config.json
ReadWritePaths=/root/portkey-model-console/.env /root/portkey-role-routing-config.json
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
