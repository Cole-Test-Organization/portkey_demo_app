#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "${repo_dir}"

python3 -m py_compile server.py tests/test_server.py
python3 -m unittest discover -s tests -v
node --check app/app.js
bash -n configure scripts/check scripts/check-secrets
python3 -m json.tool portkey-role-routing-config.example.json >/dev/null
git diff --check
scripts/check-secrets
