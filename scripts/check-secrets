#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "${repo_dir}"

secret_pattern='(-----BEGIN ([A-Z ]+ )?PRIVATE KEY-----|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{20,}|gh[pousr]_[0-9A-Za-z]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|Bearer[[:space:]]+[A-Za-z0-9._/-]{20,})'

if git grep -I -n -E "${secret_pattern}" -- . \
  ':(exclude)scripts/check-secrets'; then
  echo "Potential credential material found in tracked files." >&2
  exit 1
fi

echo "Tracked secret signatures: none found"
